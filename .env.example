# ===============================================
# Databricks Steward Agent - Configurações de Ambiente
# ===============================================

# Conexão Databricks (Unity Catalog & SQL Warehouse)
DATABRICKS_HOST=https://<your-databricks-instance>.cloud.databricks.com
DATABRICKS_TOKEN=dapi...
DATABRICKS_WAREHOUSE_ID=1234567890abcdef
DATABRICKS_DEFAULT_CATALOG=main
DATABRICKS_DEFAULT_SCHEMA=default

# Modelo Local (Ollama ou vLLM compatível com OpenAI)
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3.2:3b
LOCAL_LLM_API_KEY=ollama
LOCAL_LLM_TEMPERATURE=0.1

# GitHub GitOps (Auto commit, push e abertura de Pull Request)
GITHUB_TOKEN=ghp_...
GITHUB_REPOSITORY=owner/repository-name
GITHUB_BASE_BRANCH=main

# Configurações do Agente e Camada Semântica
SEMANTIC_MODELS_PATH=./configs/semantic_models
DEFAULT_QUERY_LIMIT=50
MAX_QUERY_LIMIT=200
